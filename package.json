{
  "name": "pane-desktop-companion",
  "version": "3.4.0",
  "productName": "Pane",
  "description": "Windows desktop window companion",
  "main": "dist/main/main.cjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build:app",
    "build:app": "node scripts/build.mjs",
    "build:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-native.ps1",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.mjs",
    "test:desktop:guide": "node tests/ui-desktop.mjs",
    "test:desktop:companion": "node tests/companion-desktop.mjs",
    "test:desktop:account": "node tests/account-desktop.mjs",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "tailwindcss": "4.3.5",
    "@tailwindcss/vite": "4.3.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "lucide-react": "^0.577.0",
    "openai": "7.62.0",
    "jose": "^6.1.0",
    "proper-lockfile": "^4.1.2",
    "@types/proper-lockfile": "^4.1.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "esbuild": "^0.27.0",
    "tsx": "^4.21.0",
    "playwright-core": "^1.58.0"
  }
}
